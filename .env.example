# Environment Configuration Example
PROJECT_NAME="Real-Time Fraud & Anomaly Detection Platform"
SECRET_KEY="FRAUDSHIELD_SUPER_SECURE_PRODUCTION_KEY_2026_JWT_0987654321"
JWT_SECRET_KEY="FRAUDSHIELD_SUPER_SECURE_PRODUCTION_KEY_2026_JWT_0987654321"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL="http://localhost:5173"

# Database Connection
# For SQLite (local development zero-config):
DATABASE_URL="sqlite+aiosqlite:///./fraud_detection.db"
SYNC_DATABASE_URL="sqlite:///./fraud_detection.db"

# For PostgreSQL (Docker Compose / Production):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fraudshield"
# SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fraudshield"

# Risk Engine Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=70
RISK_THRESHOLD_HIGH=90
ALERT_COOLDOWN_SECONDS=300

# Database Connection Pool Settings (PostgreSQL / Production)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Security Controls
MAX_REQUEST_BODY_BYTES=10485760
SECURE_HEADERS_ENABLED=true
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Observability & Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true
ENVIRONMENT="PRODUCTION"
TRACE_SAMPLE_RATE=1.0
