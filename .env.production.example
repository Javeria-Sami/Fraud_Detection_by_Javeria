# ==============================================================================
# Production Environment Configuration Template (.env.production)
# Populate with cryptographically secure values before launching production stack.
# ==============================================================================

# Application Metadata
PROJECT_NAME="Real-Time Fraud & Anomaly Detection Platform"
ENVIRONMENT="PRODUCTION"
DEBUG="false"
HOST="0.0.0.0"
PORT=8000
WEB_CONCURRENCY=4

# Cryptographic Keys (Generate with `openssl rand -hex 32`)
SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHAR_HEX_KEY_FOR_PRODUCTION_JWT_SIGNING"
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHAR_HEX_KEY_FOR_PRODUCTION_JWT_SIGNING"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (Comma-separated exact domains, no wildcards)
FRONTEND_URL="https://fraudshield.yourdomain.com"
CORS_ORIGINS="https://fraudshield.yourdomain.com,https://soc.yourdomain.com"

# Production PostgreSQL Database
POSTGRES_USER="fraudshield_app"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_DATABASE_PASSWORD"
POSTGRES_DB="fraudshield_prod"
DATABASE_URL="postgresql+asyncpg://fraudshield_app:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/fraudshield_prod"
SYNC_DATABASE_URL="postgresql://fraudshield_app:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/fraudshield_prod"

# Database Connection Pool (PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Security Controls
MAX_REQUEST_BODY_BYTES=10485760
SECURE_HEADERS_ENABLED=true

# Observability & Structured Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true
TRACE_SAMPLE_RATE=1.0

# Detection Engine Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=70
RISK_THRESHOLD_HIGH=90
ALERT_COOLDOWN_SECONDS=300
